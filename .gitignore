# Environment variables & secrets
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.tmp

# Generated media assets (rendered dynamically in runners)
data/generated_images/*
!data/generated_images/.gitkeep
data/generated_audio/*
!data/generated_audio/.gitkeep
data/generated_reels/*
!data/generated_reels/.gitkeep
*TEMP_MPY*
*.mp4
*.mp3

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.zip
